// Cloudflare Pages project "dbibridgeconnect" — a thin front door for the BridgeConnect Worker.
//
// Pages project settings: Root directory `cloudflare-pages`, Build command (empty), Build output directory
// `public`. Every request to https://dbibridgeconnect.pages.dev is forwarded inside Cloudflare's network to the
// `bridgeconnect` Worker (built from the repository root with OpenNext), which renders the app.
// This file is the source of truth for the binding; the dashboard binding settings become read-only.
{
  "name": "dbibridgeconnect",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "APP", "service": "bridgeconnect" }]
}
