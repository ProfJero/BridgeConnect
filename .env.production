# Public build-time configuration for the production (Cloudflare) build.
#
# These NEXT_PUBLIC_* values are inlined into the browser bundle anyway, so they are not secrets: the
# publishable key only identifies the Supabase project and RLS enforces all access. Committing them makes the
# Cloudflare build independent of dashboard variables (Preview builds previously failed without them).
# Variables set in the Cloudflare dashboard override these. NEVER add secret keys to this file.
NEXT_PUBLIC_SUPABASE_URL=https://mptavpfiweavlhmmasii.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_JmZZfIPo6bnPPYjn9Iayzg_DRm0_ue3
NEXT_PUBLIC_SITE_URL=https://dbibridgeconnect.pages.dev
