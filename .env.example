# -----------------------------------------------------------------------------
# BridgeConnect environment variables — see docs/environment.md
# Copy to .env.local for development. Never commit real values.
# -----------------------------------------------------------------------------

# Public (exposed to the browser). Safe to publish: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Sentry error monitoring (leave empty to disable).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
