# -----------------------------------------------------------------------------
# BridgeConnect environment variables — see docs/environment.md
# Copy to .env.local for development. Never commit real values.
# -----------------------------------------------------------------------------

# Public (exposed to the browser). Safe to publish: access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Sentry error monitoring (leave empty to disable).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Google Search Console → HTML tag method: paste only the content="…" value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cloudinary (public images). Leave the cloud name empty to use Supabase Storage instead.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only. Put these in .dev.vars locally / Worker secrets in production — never in a NEXT_PUBLIC_ var.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
